          <mxGeometry x="245" y="190" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="mt" value="&lt;b&gt;maintainer&lt;/b&gt;&lt;br&gt;rescan diff, match scoring,&lt;br&gt;repair proposals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="core">
          <mxGeometry x="470" y="190" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="&lt;b&gt;llm-gateway&lt;/b&gt;&lt;br&gt;providers, structured output,&lt;br&gt;token / latency usage log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="core">
          <mxGeometry x="30" y="333" width="260" height="75" as="geometry" />
        </mxCell>
        <mxCell id="store" value="&lt;b&gt;store&lt;/b&gt;&lt;br&gt;SQLite + artifacts/&lt;br&gt;immutable versions" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="core">
          <mxGeometry x="350" y="325" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="storenote" value="td, codegen and maintainer also read/write the store" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;" vertex="1" parent="core">
          <mxGeometry x="330" y="425" width="300" height="30" as="geometry" />
