        <mxCell id="site" value="&lt;b&gt;Target website&lt;/b&gt;&lt;br&gt;approved origin only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1100" y="640" width="260" height="60" as="geometry" />
