<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="gatp-system-design" name="System design">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;GATP: system design (HLD v0.2)&lt;/b&gt;&lt;br&gt;Supervised assistant: inspection, test design, code generation, execution and maintenance, with human approval gates" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="900" height="40" as="geometry" />
        </mxCell>

        <!-- Client -->
        <mxCell id="client" value="Browser (tester)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;startSize=28;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="240" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="&lt;b&gt;web-ui&lt;/b&gt;&lt;br&gt;React + Vite + TS&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;URL, findings, scope, goal, plan, code, approvals, results, diffs, usage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="client">
          <mxGeometry x="20" y="40" width="200" height="105" as="geometry" />
        </mxCell>

        <!-- Core -->
        <mxCell id="core" value="Core app process (FastAPI)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;startSize=28;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="340" y="60" width="640" height="500" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;api&lt;/b&gt;&lt;br&gt;orchestrator, approval gates,&lt;br&gt;workflow state machine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="core">
          <mxGeometry x="200" y="55" width="240" height="75" as="geometry" />
