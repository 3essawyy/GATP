        <mxCell id="e1" value="JSON / SSE" style="startArrow=classic;endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="ui" target="api">
