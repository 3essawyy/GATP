        <mxCell id="e6" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="cg" target="llm">
          <mxGeometry relative="1" as="geometry">
