        </mxCell>

        <!-- Gates + validation panel -->
        <mxCell id="gates" value="&lt;b&gt;Approval gates (human)&lt;/b&gt;&lt;br&gt;G0 Scope: before inspection feeds design&lt;br&gt;G1 Plan: before code generation&lt;br&gt;G2 Code: before execution can be requested&lt;br&gt;G3 Execution: every run / rerun&lt;br&gt;G4 Repair: before applying a repair&lt;br&gt;G5 Restore: before restoring a version&lt;br&gt;&lt;br&gt;&lt;b&gt;Clarification requests&lt;/b&gt; block the step that needs them (unclear expected result, non-unique locator, ambiguous repair)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="250" height="220" as="geometry" />
        </mxCell>
        <mxCell id="valid" value="&lt;b&gt;Validation layers&lt;/b&gt;&lt;br&gt;1 Inspection: locators counted live, usable only if unique&lt;br&gt;2 LLM output: schema-validated, element IDs must exist&lt;br&gt;3 Code: AST parse, locators checked vs snapshot&lt;br&gt;4 Execution: assertions never rewritten to pass&lt;br&gt;5 Maintenance: match score + margin, else ask" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="495" width="250" height="195" as="geometry" />
        </mxCell>

        <!-- Lifecycle path -->
        <mxCell id="pathtitle" value="&lt;b&gt;Path: inspection → generation → execution → maintenance&lt;/b&gt;&lt;br&gt;Every later phase builds on the stored inspection snapshot" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;1 Inspection&lt;/b&gt;&lt;br&gt;visible browser, elements, locators, fingerprints → immutable snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="290" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;2 Generation&lt;/b&gt;&lt;br&gt;grounded test cases, then POM code citing snapshot elements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="410" y="790" width="290" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;3 Execution&lt;/b&gt;&lt;br&gt;approved tests in isolated runner; results map back to element IDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="790" width="290" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;4 Maintenance&lt;/b&gt;&lt;br&gt;rescan, diff vs stored snapshot, evidence-backed repairs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1150" y="790" width="290" height="85" as="geometry" />
        </mxCell>
        <mxCell id="pe1" value="G0, G1" style="endArrow=classic;html=1;rounded=0;fontStyle=1;" edge="1" parent="1" source="p1" target="p2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe2" value="G2, G3" style="endArrow=classic;html=1;rounded=0;fontStyle=1;" edge="1" parent="1" source="p2" target="p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe3" value="rescan" style="endArrow=classic;html=1;rounded=0;fontStyle=1;" edge="1" parent="1" source="p3" target="p4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe4" value="G4, then G3 rerun" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="p4" target="p3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1295" y="905" />
              <mxPoint x="925" y="905" />
