          </mxGeometry>
        </mxCell>

        <!-- Resources -->
        <mxCell id="res" value="&lt;b&gt;Resource assumptions&lt;/b&gt;&lt;br&gt;Primary model: Gemini Flash free tier (rate limits handled by cache + backoff).&lt;br&gt;Fallback: Ollama, ~3B coder model on a 16 GB RAM machine (CPU likely).&lt;br&gt;Storage: one SQLite file + artifacts/. Secrets only in .env (gitignored)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
