# Copy to `.env` (gitignored) and adjust. Every key is optional; defaults shown.
# Read by backend/src/gatp/config.py (pydantic-settings, prefix GATP_).

# API server
GATP_API_HOST=127.0.0.1
GATP_API_PORT=8000
# JSON list of browser origins allowed to call the API directly (dev server)
GATP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
GATP_LOG_LEVEL=INFO

# Frontend dev proxy target (read by frontend/vite.config.ts)
# GATP_API_URL=http://127.0.0.1:8000

# LLM keys are added in T-005 (Gemini free tier; never commit real keys).

# Optional: Chromium binary for Playwright when `uv run poe browsers` cannot download one
# GATP_CHROMIUM_EXECUTABLE=/opt/pw-browsers/chromium-1243/chrome-linux64/chrome

# Storage (ADR-005). Delete the data/ folder to reset everything.
# GATP_DATA_DIR=data
# GATP_ARTIFACTS_DIR=artifacts
# Full SQLAlchemy URL; default is sqlite:///<GATP_DATA_DIR>/gatp.sqlite
# GATP_DATABASE_URL=

# LLM gateway (ADR-003, ADR-016; see docs/SystemGuides/SG-003-models.md)
# Providers: gemini | ollama | fake (deterministic, for tests/offline demos only)
GATP_LLM_PRIMARY=gemini
GATP_LLM_FALLBACK=ollama
# Free-tier key from https://aistudio.google.com/apikey. Keep it in .env, never commit it.
GATP_GEMINI_API_KEY=
GATP_GEMINI_MODEL=gemini-3.5-flash
GATP_OLLAMA_HOST=http://127.0.0.1:11434
GATP_OLLAMA_MODEL=qwen2.5-coder:3b
# GATP_LLM_CACHE=true
# GATP_LLM_TIMEOUT_S=120
# GATP_LLM_MAX_RETRIES=2
# GATP_LLM_BACKOFF_S=2
# GATP_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Runner (ADR-004, ADR-017). The browser is visible (headed) unless GATP_RUNNER_HEADLESS=true (CI only).
# GATP_RUNNER_SOCKET=data/runner/runner.sock
# GATP_RUNNER_HEADLESS=false
# GATP_RUNNER_SANDBOX_DIR=data/sandbox
# GATP_RUNNER_JOB_TIMEOUT_S=60
# GATP_RUNNER_SLOW_MO_MS=0
# Isolation for approved test runs: bwrap (bubblewrap, default) | process (no bubblewrap)
# GATP_RUNNER_ISOLATION=bwrap
