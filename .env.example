# Copy to `.env` (gitignored) and adjust. Every key is optional; defaults shown.
# Read by backend/src/gatp/config.py (pydantic-settings, prefix GATP_).

# API server
GATP_API_HOST=127.0.0.1
GATP_API_PORT=8000
# JSON list of browser origins allowed to call the API directly (dev server)
GATP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
GATP_LOG_LEVEL=INFO

# Frontend dev proxy target (read by frontend/vite.config.ts)
# GATP_API_URL=http://127.0.0.1:8000

# LLM keys are added in T-005 (Gemini free tier; never commit real keys).

# Optional: Chromium binary for Playwright when `uv run poe browsers` cannot download one
# GATP_CHROMIUM_EXECUTABLE=/opt/pw-browsers/chromium-1243/chrome-linux64/chrome
